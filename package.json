{
  "name": "sakay-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev:passenger",
    "dev:passenger": "npm run dev --workspace=apps/passenger-pwa",
    "build:passenger": "npm run build --workspace=apps/passenger-pwa",
    "dev:lgu": "npm run dev --workspace=apps/lgu-portal",
    "build:lgu": "npm run build --workspace=apps/lgu-portal",
    "dev:toda": "npm run dev --workspace=apps/toda-portal",
    "build:toda": "npm run build --workspace=apps/toda-portal",
    "dev:driver": "npm run dev --workspace=apps/driver-pwa",
    "build:driver": "npm run build --workspace=apps/driver-pwa",
    "dev:server": "npm run dev --workspace=server",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:all",
    "build:all": "npm run build:passenger && npm run build:driver && npm run build:toda && npm run build:lgu && npm run build:server"
  }
}
