{
  "name": "sakay-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev:passenger",
    "dev:passenger": "npm run dev --workspace=apps/passenger-pwa",
    "build:passenger": "npm run build --workspace=apps/passenger-pwa",
    "lint": "npm run lint --workspaces"
  }
}
