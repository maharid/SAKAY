# SAKAY Backend Server Environment Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://thxcltvgwwluvsfpciyr.supabase.co
SUPABASE_ANON_KEY=
# REQUIRED once the perimeter lockdown is applied: the server reads roles, OTP counters and driver records with the service role, and the
# anon key can read nothing. Keep it on the server only (never in an app).
SUPABASE_SERVICE_ROLE_KEY=

# Client CORS Origins (comma separated). In production ONLY these origins may call the API; empty means no browser origin is allowed.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# /api/scheduler/* answers 503 to everybody until this is set to 16+ random characters (the cron caller sends it in the
# X-Scheduler-Secret header). There is no default.
SCHEDULER_SECRET=

# Development only: with NODE_ENV=development, OTP_DEV_ECHO=1 and no SMS gateway configured, a one-time code is printed in THIS server's
# console instead of being texted (it is never sent to the browser and never active in production). Leave empty otherwise.
OTP_DEV_ECHO=

# Optional: how many proxy hops to trust for the client address (default 1 in production, 0 otherwise). Leave commented out unless you know why.
# TRUST_PROXY=1


# Android SMS Gateway Configuration (capcom6/android-sms-gateway)
# For Cloud Mode: https://api.sms-gate.app/3rdparty/v1
# For Local Server Mode: http://<PHONE_IP>:8080
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_LOGIN=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_DEVICE_ID=
SMS_GATEWAY_SIM_NUMBER=1

# Google Gemini Vision OCR Configuration (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=


