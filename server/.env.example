# SAKAY Backend Server Environment Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
# Replace these with your Supabase Project URL and Service Role Key (or Anon Key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client CORS Origins (Allowed Frontend URLs)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
