VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key


# Address of the SAKAY server, with "/api" at the end (e.g. https://sakay-server.onrender.com/api). Leave it unset in development: the Vite
# dev server proxies /api to http://localhost:5000. REQUIRED for a production build: the app is a static site on another address than the server.
VITE_API_URL=
