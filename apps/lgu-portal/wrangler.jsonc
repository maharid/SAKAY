// Cloudflare Workers (static assets) config for the LGU portal. Deployed from the REPO ROOT:
//   build:  npm run build:lgu
//   deploy: npx wrangler deploy --config apps/lgu-portal/wrangler.jsonc
// "assets.directory" is relative to THIS file. The Worker name must equal the project name in the Cloudflare dashboard.
{
  "name": "sakay-lgu",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    // every path that is not a file (/dashboard, /toda-applications, ...) gets index.html
    "not_found_handling": "single-page-application"
  }
}
