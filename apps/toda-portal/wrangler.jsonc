// Cloudflare Workers (static assets) config for the TODA portal. Deployed from the REPO ROOT:
//   build:  npm run build:toda
//   deploy: npx wrangler deploy --config apps/toda-portal/wrangler.jsonc
// "assets.directory" is relative to THIS file. The Worker name must equal the project name in the Cloudflare dashboard.
{
  "name": "sakay-toda",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    // every path that is not a file (/operations, /drivers, ...) gets index.html
    "not_found_handling": "single-page-application"
  }
}
